# Ignorar la carpeta estática generada por collectstatic
/staticfiles/

# Variables de entorno
.env
.env.*
!.env.example

# Entornos virtuales y bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Archivos del sistema
.DS_Store

# Bases de datos locales
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Logs, temporales y copias de seguridad
*.log
logs/
*.tmp
*.bak

# Configuración local de IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
